generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alerte_securite {
  id                                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cite_id                                String         @db.Uuid
  habitant_id                            String         @db.Uuid
  villa_id                               String?        @db.Uuid
  motif_id                               Int?
  description                            String?
  photo_file_path                        String?        @db.VarChar(500)
  silencieuse                            Boolean?       @default(false)
  statut_id                              Int?
  escalade                               Boolean?       @default(false)
  escalade_at                            DateTime?      @db.Timestamp(6)
  resolu_par                             String?        @db.Uuid
  resolu_at                              DateTime?      @db.Timestamp(6)
  created_at                             DateTime?      @default(now()) @db.Timestamp(6)
  updated_at                             DateTime?      @db.Timestamp(6)
  deleted_at                             DateTime?      @db.Timestamp(6)
  is_deleted                             Boolean?       @default(false)
  created_by                             String?        @db.Uuid
  updated_by                             String?        @db.Uuid
  deleted_by                             String?        @db.Uuid
  cite                                   cite           @relation(fields: [cite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_alerte_securite_habitant_idTouser user           @relation("alerte_securite_habitant_idTouser", fields: [habitant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  motif_alerte                           motif_alerte?  @relation(fields: [motif_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_alerte_securite_resolu_parTouser  user?          @relation("alerte_securite_resolu_parTouser", fields: [resolu_par], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statut_alerte                          statut_alerte? @relation(fields: [statut_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  villa                                  villa?         @relation(fields: [villa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cite_id], map: "idx_alerte_cite_id")
  @@index([created_at], map: "idx_alerte_created_at")
  @@index([escalade], map: "idx_alerte_escalade")
  @@index([is_deleted], map: "idx_alerte_is_deleted")
  @@index([statut_id], map: "idx_alerte_statut_id")
}

model annonce {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cite_id           String             @db.Uuid
  auteur_id         String             @db.Uuid
  categorie_id      Int?
  titre             String             @db.VarChar(255)
  contenu           String
  est_epinglee      Boolean?           @default(false)
  created_at        DateTime?          @default(now()) @db.Timestamp(6)
  updated_at        DateTime?          @db.Timestamp(6)
  deleted_at        DateTime?          @db.Timestamp(6)
  is_deleted        Boolean?           @default(false)
  created_by        String?            @db.Uuid
  updated_by        String?            @db.Uuid
  deleted_by        String?            @db.Uuid
  user              user               @relation(fields: [auteur_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categorie_annonce categorie_annonce? @relation(fields: [categorie_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cite              cite               @relation(fields: [cite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cite_id], map: "idx_annonce_cite_id")
  @@index([est_epinglee], map: "idx_annonce_epinglee")
}

model app_config {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(100)
  value       String?   @db.VarChar(500)
  module      String?   @db.VarChar(100)
  description String?
  created_at  DateTime? @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  is_deleted  Boolean?  @default(false)
  created_by  Int?
  updated_by  Int?
  deleted_by  Int?
}

model audit_log {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cite_id           String?   @db.Uuid
  user_id           String?   @db.Uuid
  profil_actif_code String?   @db.VarChar(100)
  action            String    @db.VarChar(100)
  entite            String    @db.VarChar(100)
  entite_id         String?   @db.VarChar(255)
  anciennes_valeurs Json?
  nouvelles_valeurs Json?
  ip_address        String?   @db.VarChar(45)
  user_agent        String?   @db.VarChar(500)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  cite              cite?     @relation(fields: [cite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              user?     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cite_id], map: "idx_audit_cite_id")
  @@index([created_at], map: "idx_audit_created_at")
  @@index([entite], map: "idx_audit_entite")
  @@index([profil_actif_code], map: "idx_audit_profil_actif")
  @@index([user_id], map: "idx_audit_user_id")
}

model canal_paiement {
  id         Int        @id
  libelle    String?    @db.VarChar(255)
  code       String     @unique @db.VarChar(100)
  is_manuel  Boolean?   @default(false)
  created_at DateTime?  @db.Timestamp(6)
  updated_at DateTime?  @db.Timestamp(6)
  deleted_at DateTime?  @db.Timestamp(6)
  is_deleted Boolean?   @default(false)
  created_by Int?
  updated_by Int?
  deleted_by Int?
  paiement   paiement[]
}

model categorie_annonce {
  id         Int       @id
  libelle    String?   @db.VarChar(255)
  code       String    @unique @db.VarChar(100)
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  is_deleted Boolean?  @default(false)
  created_by Int?
  updated_by Int?
  deleted_by Int?
  annonce    annonce[]
}

model categorie_conflit {
  id         Int       @id
  libelle    String?   @db.VarChar(255)
  code       String    @unique @db.VarChar(100)
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  is_deleted Boolean?  @default(false)
  created_by Int?
  updated_by Int?
  deleted_by Int?
  conflit    conflit[]
}

model categorie_incident {
  id         Int        @id
  libelle    String?    @db.VarChar(255)
  code       String     @unique @db.VarChar(100)
  icon_name  String?    @db.VarChar(100)
  created_at DateTime?  @db.Timestamp(6)
  updated_at DateTime?  @db.Timestamp(6)
  deleted_at DateTime?  @db.Timestamp(6)
  is_deleted Boolean?   @default(false)
  created_by Int?
  updated_by Int?
  deleted_by Int?
