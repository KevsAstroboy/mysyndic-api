  categorie_id                            Int?
  villa_ciblee_id                         String?            @db.Uuid
  villa_ciblee_num                        String             @db.VarChar(50)
  description                             String
  statut_id                               Int?
  note_syndic                             String?
  resolution_note                         String?
  pris_en_charge_par                      String?            @db.Uuid
  pris_en_charge_at                       DateTime?          @db.Timestamp(6)
  resolu_at                               DateTime?          @db.Timestamp(6)
  created_at                              DateTime?          @default(now()) @db.Timestamp(6)
  updated_at                              DateTime?          @db.Timestamp(6)
  deleted_at                              DateTime?          @db.Timestamp(6)
  is_deleted                              Boolean?           @default(false)
  created_by                              String?            @db.Uuid
  updated_by                              String?            @db.Uuid
  deleted_by                              String?            @db.Uuid
  categorie_conflit                       categorie_conflit? @relation(fields: [categorie_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cite                                    cite               @relation(fields: [cite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_conflit_declarant_idTouser         user               @relation("conflit_declarant_idTouser", fields: [declarant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_conflit_pris_en_charge_parTouser   user?              @relation("conflit_pris_en_charge_parTouser", fields: [pris_en_charge_par], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statut_conflit                          statut_conflit?    @relation(fields: [statut_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
