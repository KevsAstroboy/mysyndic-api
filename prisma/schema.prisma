model cite {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                String               @db.VarChar(255)
  ville              String?              @db.VarChar(255)
  pays               String?              @default("Côte d'Ivoire") @db.VarChar(100)
  is_active          Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @db.Timestamp(6)
  deleted_at         DateTime?            @db.Timestamp(6)
  is_deleted         Boolean?             @default(false)
  created_by         String?              @db.Uuid
  updated_by         String?              @db.Uuid
  deleted_by         String?              @db.Uuid
  alerte_securite    alerte_securite[]
  annonce            annonce[]
  audit_log          audit_log[]
  configuration      configuration?
  conflit            conflit[]
  document           document[]
  feed_post          feed_post[]
  feed_post_media    feed_post_media[]
  groupe_cite        groupe_cite?
  groupe_cite_membre groupe_cite_membre[]
  incident           incident[]
  message            message[]
  notification       notification[]
  paiement           paiement[]
  recu_paiement      recu_paiement[]
  user               user[]
  user_profil        user_profil[]
  user_villa         user_villa[]
  villa              villa[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model configuration {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cite_id                   String    @unique @db.Uuid
  cotisation_mensuelle      Int?
  lien_wave                 String?   @db.VarChar(500)
  telephone_syndic          String?   @db.VarChar(50)
  telephone_urgence         String?   @db.VarChar(50)
paystack_subaccount_code String? @db.VarChar(255)
  paystack_subaccount_mode String? @default("SIMPLE") @db.VarChar(10)
  paystack_subaccount_split Int? @default(100)
  paystack_subaccount_percentage Int? @default(0)
  nombre_villas_attendu     Int?
  created_at                DateTime? @default(now()) @db.Timestamp(6)
  updated_at                DateTime? @db.Timestamp(6)
  deleted_at                DateTime? @db.Timestamp(6)
  is_deleted                Boolean?  @default(false)
  created_by                String?   @db.Uuid
  updated_by                String?   @db.Uuid
  deleted_by                String?   @db.Uuid
  cite                      cite      @relation(fields: [cite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model conflit {
  id                                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
