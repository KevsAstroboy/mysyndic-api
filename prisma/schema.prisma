  villa_conflit_villa_declarant_idTovilla villa?             @relation("conflit_villa_declarant_idTovilla", fields: [villa_declarant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cite_id], map: "idx_conflit_cite_id")
  @@index([declarant_id], map: "idx_conflit_declarant")
  @@index([statut_id], map: "idx_conflit_statut_id")
