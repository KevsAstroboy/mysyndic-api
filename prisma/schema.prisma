/// Le type du post (texte / photo / vidéo) se déduit des lignes feed_post_media.
model feed_post {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cite_id              String                  @db.Uuid
  auteur_id            String                  @db.Uuid
  contenu              String?
  likes_count          Int                     @default(0)
  commentaires_count   Int                     @default(0)
  created_at           DateTime?               @default(now()) @db.Timestamp(6)
  updated_at           DateTime?               @db.Timestamp(6)
  deleted_at           DateTime?               @db.Timestamp(6)
  is_deleted           Boolean?                @default(false)
  created_by           String?                 @db.Uuid
  updated_by           String?                 @db.Uuid
  deleted_by           String?                 @db.Uuid
  cite                 cite                    @relation(fields: [cite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                 user                    @relation(fields: [auteur_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feed_post_commentaire feed_post_commentaire[]
  feed_post_like       feed_post_like[]
  feed_post_media      feed_post_media[]

  @@index([auteur_id], map: "idx_feed_post_auteur_id")
  @@index([is_deleted], map: "idx_feed_post_is_deleted")
}

model feed_post_commentaire {
  id                          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id                     String                  @db.Uuid
  auteur_id                   String                  @db.Uuid
  parent_id                   String?                 @db.Uuid
  niveau                      Int                     @default(1) @db.SmallInt
  texte                       String
  created_at                  DateTime?               @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?               @db.Timestamp(6)
  deleted_at                  DateTime?               @db.Timestamp(6)
  is_deleted                  Boolean?                @default(false)
  created_by                  String?                 @db.Uuid
  updated_by                  String?                 @db.Uuid
  deleted_by                  String?                 @db.Uuid
  user                        user                    @relation(fields: [auteur_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feed_post                   feed_post               @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feed_post_commentaire        feed_post_commentaire?  @relation("feed_post_commentaireTofeed_post_commentaire", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_feed_post_commentaire  feed_post_commentaire[] @relation("feed_post_commentaireTofeed_post_commentaire")

  @@index([auteur_id], map: "idx_feed_comment_auteur_id")
  @@index([niveau], map: "idx_feed_comment_niveau")
  @@index([parent_id], map: "idx_feed_comment_parent_id")
}

model feed_post_like {
  post_id    String     @db.Uuid
  user_id    String     @db.Uuid
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  feed_post  feed_post  @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       user       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@index([user_id], map: "idx_feed_like_user_id")
}

model feed_post_media {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String     @db.Uuid
  cite_id    String     @db.Uuid
  type       String     @db.VarChar(20)
  file_path  String     @db.VarChar(500)
  mime_type  String     @db.VarChar(100)
  taille_ko  Int?
  ordre      Int        @default(1) @db.SmallInt
  largeur    Int?
  hauteur    Int?
  duree_sec  Int?
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  updated_at DateTime?  @db.Timestamp(6)
  deleted_at DateTime?  @db.Timestamp(6)
  is_deleted Boolean?   @default(false)
  created_by String?    @db.Uuid
  updated_by String?    @db.Uuid
  deleted_by String?    @db.Uuid
  cite       cite       @relation(fields: [cite_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feed_post  feed_post  @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([post_id, ordre])
  @@index([cite_id], map: "idx_feed_media_cite_id")
}

