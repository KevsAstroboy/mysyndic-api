# ============================================================================
# mysyndic-api — Environment Variables
# ============================================================================
# Copier ce fichier : cp .env.example .env
# Les URLs utilisent les hostnames Docker internes (voir docker-compose.yml).
# ============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mysyndic_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mysyndic_db
# Pour un accès depuis l'hôte (prisma db pull local) :
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mysyndic_db

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo
MONGO_INITDB_DATABASE=mysyndic_messages
MONGO_PORT=27018
MONGO_URI=mongodb://mongo:mongo@mongodb:27017/mysyndic_messages?authSource=admin

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://redis:6379

# ─── MinIO (S3-compatible) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=minio
MINIO_INTERNAL_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mysyndic-uploads
MINIO_USE_SSL=false
# Endpoint public utilisé pour signer les URLs lues par le navigateur.
# En dev Docker : le hostname interne `minio` n'est pas résolvable côté hôte,
# on signe donc vers le port publié (9010). En prod : domaine public MinIO.
MINIO_PUBLIC_ENDPOINT=192.168.1.8
MINIO_PUBLIC_PORT=9010
MINIO_PUBLIC_USE_SSL=false
MINIO_REGION=us-east-1

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=change-me-refresh-64-char-random-string
JWT_REFRESH_EXPIRY=7d

# ─── Sessions / RBAC Redis ────────────────────────────────────────────────────
REDIS_SESSION_TTL_SECONDS=86400
REDIS_MSG_LU_TTL_DAYS=30

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3001
APP_NAME=MySyndic

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre-email@gmail.com
MAIL_PASS=xxx
MAIL_FROM="MySyndic <votre-email@gmail.com>"

# ─── Paystack ─────────────────────────────────────────────────────────────────
# La clé secrète sert à l'API ET à la vérification HMAC des webhooks.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
AT_API_KEY=xxx
AT_USERNAME=mysyndic
AT_FROM=MySyndicPAYSTACK_CALLBACK_URL=http://localhost:3001/paiements/confirmation
