{"nodes": [{"id": "openspec_specs_paiement_webhook_spec", "label": "Paiement Webhook Spec", "file_type": "document", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_specs_paiement_webhook_spec_initiation", "label": "Initiation d'un paiement Paystack", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: Initiation d'un paiement Paystack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies current villa occupancy, reads montant from configuration.cotisation_mensuelle, inserts EN_ATTENTE PAYSTACK, calls /transaction/initialize, returns authorization_url + reference; confirmed (villa,mois) refused."}, {"id": "openspec_specs_paiement_webhook_spec_webhook_signature", "label": "Reception du webhook Paystack (signature HMAC-SHA512)", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: R\u00e9ception du webhook Paystack (signature)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public POST /webhooks/paystack; verify HMAC-SHA512 of raw body with aggregator webhook key before any handling; invalid signature stored signature_ok=false and returns 401."}, {"id": "openspec_specs_paiement_webhook_spec_idempotence", "label": "Idempotence proof webhook", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: Idempotence proof webhook", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE(aggregateur_code, reference) prevents reprocessing; duplicate returns 200 with no double effect."}, {"id": "openspec_specs_paiement_webhook_spec_traitement_async", "label": "Traitement asynchrone du webhook", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: Traitement asynchrone du webhook", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns 200 right after signature validation then fire-and-forget: checks montant_match, confirms payment, generates PDF receipt, notifies residents, writes audit."}, {"id": "openspec_specs_paiement_webhook_spec_saisie_manuelle", "label": "Saisie manuelle d'un paiement", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: Saisie manuelle d'un paiement", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Syndic (PAIEMENT_SAISIE_MANUELLE) enters one or more months for a villa via WAVE_MANUEL/ORANGE_MANUEL/MTN_MANUEL/CASH; capped by MULTI_MOIS_PAIEMENT_MAX; already-confirmed month refused; each month generates PDF receipt."}, {"id": "openspec_specs_paiement_webhook_spec_historique_stats", "label": "Historique et statistiques de paiement", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: Historique et statistiques", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Villa history identical for all occupants; current-month unpaid and monthly recovery via views filtered by cite."}, {"id": "openspec_specs_paiement_webhook_spec_recu_pdf", "label": "Recu PDF (PDFKit + MinIO)", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: Re\u00e7u PDF", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each confirmed payment gets a PDFKit receipt (logo, cite, villa, month, amount, channel, reference, datetime, QR verification link) stored on MinIO; URL generated on-demand if absent."}, {"id": "openspec_specs_paiement_webhook_spec_export_excel", "label": "Export Excel des paiements", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": "Requirement: Export Excel des paiements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PAIEMENT_EXPORT_EXCEL; columns Villa, Mois, Montant, Canal, Statut, Date, Saisi Par."}, {"id": "openspec_specs_paiement_webhook_spec_paiement_saisie_manuelle", "label": "Feature PAIEMENT_SAISIE_MANUELLE", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_specs_paiement_webhook_spec_paiement_export_excel", "label": "Feature PAIEMENT_EXPORT_EXCEL", "file_type": "concept", "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "openspec_specs_paiement_webhook_spec", "target": "openspec_specs_paiement_webhook_spec_initiation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_paiement_webhook_spec", "target": "openspec_specs_paiement_webhook_spec_webhook_signature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_paiement_webhook_spec", "target": "openspec_specs_paiement_webhook_spec_idempotence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/paiement-webhook/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_paiement_webhook_spec", "target": "openspec_specs_paiement_webhook_spec_traitement_async", "relation": "references", "confidence": "EXTRACTED", "confidence_