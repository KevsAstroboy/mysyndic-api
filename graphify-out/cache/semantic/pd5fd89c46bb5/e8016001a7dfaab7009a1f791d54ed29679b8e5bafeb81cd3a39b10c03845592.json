{"nodes": [{"id": "openspec_changes_archive_2026_09_05_sprint_4_messagerie_documents_notifications_design", "label": "Sprint 4 - Design", "file_type": "document", "source_file": "openspec/changes/archive/2026-09-05-sprint-4-messagerie-documents-notifications/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_09_05_sprint_4_messagerie_documents_notifications_design_cite_scoping", "label": "Systematic Cite Scoping (cite_id)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-09-05-sprint-4-messagerie-documents-notifications/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every message/document/notification query filters cite_id from JWT session; out-of-cite yields 403/404. cite_id=null (super admin) yields 403. Prevents cross-cite data leakage."}, {"id": "openspec_changes_archive_2026_09_05_sprint_4_messagerie_documents_notifications_design_soft_delete", "label": "Soft Delete (is_deleted, deleted_at)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-09-05-sprint-4-messagerie-documents-notifications/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entities are never hard-deleted; is_deleted/deleted_at/deleted_by flags hide rows from listing while preserving audit trail."}, {"id": "openspec_changes_archive_2026_09_05_sprint_4_messagerie_documents_notifications_design_chat_gateway", "label": "ChatGateway (socket.io global)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-09-05-sprint-4-messagerie-documents-notifications/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global @WebSocketGateway in src/sockets/ with user:{userId} and cite:{citeId} rooms; JWT handshake auth