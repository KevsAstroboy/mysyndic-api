{"nodes": [{"id": "openspec_changes_archive_2026_09_05_paystack_subaccounts_per_cite_design_subaccount_per_cite", "label": "Paystack Subaccount per Cite", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-09-05-paystack-subaccounts-per-cite/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compte marchand master MySyndic + un subaccount par cit\u00e9, split automatique \u00e0 la charge: z\u00e9ro reversement manuel, une seule paire de cl\u00e9s globale. Alternatives \u00e9cart\u00e9es: compte marchand par cit\u00e9, plateforme encaisse + reverse central (float + ops legales)."}, {"id": "openspec_changes_archive_2026_09_05_paystack_subaccounts_per_cite_design_global_keys", "label": "Global Paystack Keys in app_config", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-09-05-paystack-subaccounts-per-cite/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "configuration perd paystack_public_key/paystack_secret_key; app_config gagne PAYSTACK_PUBLIC_KEY, PAYSTACK_SECRET_KEY, PAYSTACK_CURRENCY=XOF."}, {"id": "openspec_changes_archive_2026_09_05_paystack_subaccounts_per_cite_design_simple_mode", "label": "Checkout SIMPLE Mode", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-09-05-paystack-subaccounts-per-cite/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "subaccount: <code> + bearer: account (frais pay\u00e9s par MySyndic, syndic re\u00e7oit le net nominal)."}, {"id": "openspec_changes_archive_2026_09_05_paystack_subaccounts_per_cite_design_split_mode", "label": "Checkout SPLIT Mode", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-09-05-paystack-subaccounts-per-cite/design.md", "source_location": null, "source_url": null, "captured_at": null, "aut